<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network security configuration for NivaTV.
  This file lives under src/debug so it is ONLY merged into debug builds,
  never into release builds. It permits cleartext (http://) traffic solely
  for local development endpoints:
    - 10.0.2.2   -> Android emulator's alias for the host machine
    - localhost / 127.0.0.1 -> local loopback, useful for adb reverse setups
  Release builds use the stricter config at
  android/app/src/main/res/xml/network_security_config.xml, which disallows
  cleartext entirely.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
