<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug-only override: permits cleartext HTTP solely for local dev
         endpoints (10.0.2.2 / localhost / 127.0.0.1). This manifest is only
         merged into debug builds, so it never affects release builds, which
         use the stricter network_security_config.xml under src/main. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:replace="android:networkSecurityConfig"
        xmlns:tools="http://schemas.android.com/tools" />
</manifest>
