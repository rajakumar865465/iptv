<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security configuration for NivaTV (Android release/production builds).
  - Cleartext (http://) traffic is disallowed. Only HTTPS is permitted.
  - Only system-trusted CAs are trusted (user-installed CAs are no longer
    trusted here to prevent a malicious or misconfigured proxy CA from
    intercepting traffic in production).
  Local development against http://10.0.2.2 (Android emulator) is handled by
  a separate debug-only override at
  android/app/src/debug/res/xml/network_security_config.xml, which only
  applies to debug builds.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
