{
  "name": "iptv-backend",
  "version": "1.0.0",
  "description": "NivaTV Backend API with License System",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --coverage",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "import-iptv": "node scripts/import-iptv-org.js",
    "seed-categories": "node scripts/seed-indian-categories.js",
    "import-indian": "node scripts/import-indian-streams.js --source=both --limit=none --include-offline=true",
    "check-streams": "node scripts/check-streams-deep.js --all --concurrency=10",
    "check-pending": "node scripts/check-streams-deep.js --pending --concurrency=10",
    "check-logos": "node scripts/check-logos.js",
    "check-logos-missing": "node scripts/check-logos.js --missing-only",
    "dedupe": "node scripts/dedupe-channels.js",
    "dedupe-dry": "node scripts/dedupe-channels.js --dry-run",
    "activate": "node scripts/activate-working-channels.js",
    "report": "node scripts/generate-report.js",
    "import-working": "node scripts/import-working-m3u.js",
    "import-all-custom": "node scripts/import-008-channels.js && node scripts/import-working-m3u.js && node scripts/import-working-m3u.js --file ../updated_channels.m3u",
    "import-working-replace": "node scripts/import-working-m3u.js --replace-dead",
    "import-premium": "node scripts/import-008-channels.js",
    "fix-categories": "node scripts/fix-imported-categories.js",
    "recover": "node scripts/recover.js",
    "setup-indian": "npm run seed-categories && npm run import-indian && npm run dedupe && npm run check-streams && npm run check-logos && npm run activate && npm run report"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "iptv",
    "live-tv",
    "flutter",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.2.0",
    "iptv-playlist-parser": "^0.15.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "node-fetch": "^2.7.0",
    "pg": "^8.22.0",
    "razorpay": "^2.9.6",
    "sharp": "^0.35.2",
    "ws": "^8.21.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
