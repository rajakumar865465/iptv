# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=iptv_db
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Secrets (use strong random strings in production)
JWT_SECRET=your_jwt_secret_key_here
ADMIN_JWT_SECRET=your_admin_jwt_secret_key_here

# Server Settings
PORT=5000
NODE_ENV=development

# Filter Settings
# Set to true to show channels with health_status=unknown or NULL when workingOnly=true
# Useful during testing/onboarding before stream health checks have run
ALLOW_UNKNOWN_STREAMS=true

# CORS
# Comma-separated list of allowed origins (leave empty to allow all)
CORS_ORIGINS=
