# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=iptv_db
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Secrets (use strong random strings in production)
JWT_SECRET=your_jwt_secret_key_here
ADMIN_JWT_SECRET=your_admin_jwt_secret_key_here

# Server Settings
PORT=5000
NODE_ENV=development

# Database Pool (DB-02 fix: set higher in production, keep low for free-tier)
# DB_POOL_MAX=20   # production
# DB_POOL_MAX=10   # development / free tier

# Filter Settings
# Set to true to show channels with health_status=unknown or NULL when workingOnly=true
# Useful during testing/onboarding before stream health checks have run
# Set to false in production once streams have been health-checked
ALLOW_UNKNOWN_STREAMS=true

# CORS
# Comma-separated list of allowed origins (leave empty to allow all)
CORS_ORIGINS=

# Maintenance
# Required header value for maintenance endpoints (POST /api/internal/maintenance/*)
MAINTENANCE_SECRET=your_maintenance_secret_here

# Transcode (PLAYBACK-04 fix: max simultaneous FFmpeg sessions; protect CPU on small instances)
# MAX_TRANSCODE_SESSIONS=4
